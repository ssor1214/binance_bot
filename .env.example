# 신규 진입을 완전히 차단한다. 기존 포지션의 손절/익절/트레일링 관리는 계속된다.
CRITICAL_BALANCE_STOP_USDT=5.0

# 하루 목표 수익률(%). 달성하면 텔레그램으로 계속할지 물어보고, 이후 STEP%씩 더 오를 때마다 다시 물어봄
# [2026-08-11 사용자요청] 50%, 100% 딱 2번만 물어보도록 변경(그 이후엔 알림 없이 계속 거래)
DAILY_PROFIT_TARGET_PCT=50
DAILY_PROFIT_STEP_PCT=50
DAILY_PROFIT_MAX_CHECKPOINTS=2

# [2026-08-07 설정, 2026-08-11 999로 방치돼있던 걸 발견/원복] 일일 손실 서킷브레이커 —
# 하루 기준자산 대비 이 비율(%) 이상 손실나면 신규 진입을 자동으로 멈춤(기존 포지션 관리는
# 계속). DAILY_LOSS_PAUSE_HOURS(4시간) 후 날짜와 무관하게 자동 재개.
# [2026-08-11 사용자요청] 슬롯방식 테스트 기간(내일 20:13까지) 동안은 일부러 무제한(999)으로
# 꺼둠 — 코드/로직은 완성돼 있고 다음 원복 때 15로 되돌릴 것. 잊지 말 것!
DAILY_LOSS_LIMIT_PCT=999
DAILY_LOSS_PAUSE_HOURS=4

# [2026-08-11 사용자요청] 글로벌 연패 서킷브레이커(5연패->10분 정지)도 같은 이유로
# 슬롯방식 테스트 기간 동안은 무제한(999)으로 꺼둠. 다음 원복 때 5로 되돌릴 것.
GLOBAL_LOSS_STREAK_THRESHOLD=999


# 익절/손절 기준 — 모두 ROE%(레버리지 반영, 바이낸스 앱 표시값과 동일) 기준
