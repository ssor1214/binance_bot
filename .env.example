LOW_BALANCE_NEW_ENTRY_PAUSE_THRESHOLD=17
LOW_BALANCE_RECOVERY_MIN_PROBABILITY=0.65

# [2026-08-12 사용자요청] "자산이 5불만 남으면 거래 자체를 멈춰줘" — 위 저잔고 복구모드
