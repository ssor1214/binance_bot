# Binance API 키 (선물 거래 권한 필요, 출금 권한은 끄는 것을 강력 권장)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true 로 두면 Binance Futures Testnet(모의투자)로 접속합니다.
# 처음 실행하는 것이라면 반드시 true로 먼저 검증하세요.
USE_TESTNET=true

# 거래할 심볼 (쉼표로 여러 개 지정 가능, AUTO로 두면 거래 가능한 USDT 무기한 선물 코인을 자동으로 대상에 포함)
SYMBOLS=AUTO
# AUTO일 때 24시간 거래대금 상위 몇 개까지만 스캔할지 (너무 많으면 API 요청 한도 초과 위험)
MAX_AUTO_SYMBOLS=250

# 캔들 주기
# [2026-08-06] 펌프감지 재설계 — 72시간/200심볼 백테스트가 5분봉 기준으로 검증됨
INTERVAL=1m

# 레버리지 (신호 강도에 따라 이 범위 안에서 자동 결정)
# [2026-08-05] 사용자 요청으로 4배 고정 (min=max=4)
LEVERAGE_MIN=4
LEVERAGE_MAX=4

# 포지션 비중 (연속 승리 시 이 범위 안에서 자동으로 커짐, 손실 나면 최소치로 복귀)
POSITION_SIZE_MIN=0.2
POSITION_SIZE_MAX=0.4
POSITION_SIZE_STEP=0.1

# 잔고가 이 값(USDT) 미만이면 아래 최대 비중까지 허용 (소액일 때 최소주문금액 충족을 위해)
# 100%로 두면 연승 중 포지션 하나에 전 재산이 들어갈 수 있어, 그 사이 다른 좋은 후보를
# 놓칠 수 있음 (과거 QA에서 실제 발견된 트레이드오프) — 자산 500달러 미만까지는 공격적으로
# 굴리기로 사용자가 명시적으로 결정함
SMALL_BALANCE_THRESHOLD=500
SMALL_BALANCE_MAX_RATIO=1.0

# 총자산이 이 값(USDT) 미만이면 동시 보유 포지션을 1~MAX_POSITIONS_LOW개로 제한(자금 비례),
# 이상이면 MAX_POSITIONS_HIGH개까지 허용
BALANCE_TIER_THRESHOLD=300
MAX_POSITIONS_LOW=3
MAX_POSITIONS_HIGH=8

# 총자산이 이 값(USDT) 미만이면 초기 자금 불리기 단계로 보고 조금 더 공격적으로 거래함
# (동시 포지션 개수 확대 + 진입 신호 기준 완화)
AGGRESSIVE_BALANCE_THRESHOLD=100
AGGRESSIVE_MAX_POSITIONS=3
AGGRESSIVE_MIN_SIGNAL_CONFIRMATIONS=2

# 하루 목표 수익률(%). 달성하면 텔레그램으로 계속할지 물어보고, 이후 STEP%씩 더 오를 때마다 다시 물어봄
DAILY_PROFIT_TARGET_PCT=20
DAILY_PROFIT_STEP_PCT=30

# [2026-08-07] 일일 손실 서킷브레이커 — 하루 기준자산 대비 이 비율(%) 이상 손실나면
# 신규 진입을 자동으로 멈춤(기존 포지션 관리는 계속). 날짜 바뀌면 자동 해제.
DAILY_LOSS_LIMIT_PCT=999


# 익절/손절 기준 — 모두 ROE%(레버리지 반영, 바이낸스 앱 표시값과 동일) 기준
# [2026-08-06] 8%부터 트레일링(고점대비 3%p 밀리면 확정, 상한20%)이 즉시확정보다 순이익 개선됨을
# 72시간/300심볼 재검증으로 확인 후 적용. 롱/숏 모두 동일 적용(예전 "숏만 즉시확정" 비대칭 제거).
TAKE_PROFIT_MIN=4.0
SHORT_TAKE_PROFIT_MIN=4.0
TAKE_PROFIT_MAX=20.0
TAKE_PROFIT_HARD_CAP=20.0
PROFIT_HOLD_REVERSAL_VOTES=3
STOP_LOSS_PCT=3.5
TRAIL_DRAWDOWN_PCT=1.5

# 물타기: 손절선의 이 비율 지점(ROE 기준)에서, 포지션당 1회만, 가용잔고의 이 비율만큼 추가 투입
AVERAGE_DOWN_ENABLED=false
AVERAGE_DOWN_TRIGGER_RATIO=0.5
AVERAGE_DOWN_SIZE_RATIO=0.5

# 손실 중일 때, 추세 전환 신호(3개 중 이만큼: EMA/MACD/RSI)가 나오면 손절선까지 안 기다리고 조기 탈출
REVERSAL_MIN_VOTES=3
# 조기 탈출은 손실이 최소 이만큼(ROE %)은 돼야 고려함 (작은 노이즈에 반응해 수수료만 나가는 것 방지)
# [2026-08-06] 펌프감지 백테스트는 손절선까지 그대로 완주하는 모델이라 조기탈출 사실상 비활성
EARLY_EXIT_MIN_LOSS_ROE=1.5
# [2026-08-06] 펌프감지 백테스트는 5분봉 12캔들(=60분) 관찰창으로 검증됨
SCALP_MAX_HOLD_MINUTES=60
# 익절 최소선을 넘은 뒤, 실제 수익이 이만큼(USDT) 더 늘면 바로 매도 (작을수록 자주 매도됨)
PROFIT_BUFFER_USDT=0.3
PROFIT_LOCK_BUFFER_PCT=1.0

# 총자산이 이 값(USDT) 미만이면 %가 아니라 절대금액(수수료 제외 순수익) 기준으로 즉시 익절
SMALL_PROFIT_BALANCE_THRESHOLD=40
SMALL_PROFIT_TARGET_USDT=0.10
FEE_RATE_ROUNDTRIP=0.001

# 지표 파라미터 — 15~30분 스윙 목표에 맞춘 구간(1분봉 기준 EMA26/MACD26=약 26분 창)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_FAST=12
EMA_SLOW=26
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# 스토캐스틱 RSI (모멘텀 이중 확인)
STOCH_RSI_PERIOD=14
STOCH_RSI_OVERSOLD=20
STOCH_RSI_OVERBOUGHT=80

# 볼린저 밴드 (변동성 참고용, 계산만 됨)
BB_PERIOD=20
BB_STD=2

# ATR (변동성 측정, 계산만 됨)
ATR_PERIOD=14

# ADX (추세 강도 필터, 이 값 이상일 때만 진입 — 횡보장 거짓신호 방지)
ADX_PERIOD=14
ADX_THRESHOLD=20

# 거래량 이동평균 (평균 이상일 때만 진입 — 가짜 돌파 방지)
VOLUME_MA_PERIOD=20

# 텔레그램 알림/조회 (BotFather에서 발급받은 토큰과 내 Chat ID를 입력하면 활성화됨)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 정기 요약(기준자산/오늘수익률/포지션/메뉴) 전송 주기(초). 매수/매도 알림은 이와 별개로 즉시 전송됨
TELEGRAM_DIGEST_INTERVAL_SEC=600

# 마진 비율(유지증거금/마진잔고)이 이 값을 넘으면 신규 진입을 자동 차단 (0.20 = 20%)
MAX_MARGIN_RATIO=0.30

# 포지션당 실제 증거금(마진)이 최소 이 값(USDT) 이상이 되도록 함 (너무 작은 증거금 진입 방지)
MIN_MARGIN_USDT=5
# 총자산이 AGGRESSIVE_BALANCE_THRESHOLD(기본 100 USDT) 미만이면 최소 증거금을 이 값으로 낮춤
AGGRESSIVE_MIN_MARGIN_USDT=8

# [2026-08-06] 펌프감지 신호는 지표 1개(변동폭+거래량 동시조건)뿐이라 1로 설정
MIN_SIGNAL_CONFIRMATIONS=1
AGGRESSIVE_MIN_SIGNAL_CONFIRMATIONS=1

# [2026-08-06] 확률/총점 게이트는 새 신호로 검증된 적 없어 사실상 무력화(0). 신호 자체가 필터.
MIN_ENTRY_PROBABILITY=0.63
SHORT_MIN_ENTRY_PROBABILITY=0.68
SHORT_SIZE_MULTIPLIER=0.6
SHORT_MIN_TOTAL_SCORE=0
LONG_MIN_TOTAL_SCORE=0
# 진입 확률 추정치가 이 값 이상이면 비중을 크게 키운다 (단, 아무리 확신해도 전 재산을
# 한 종목에 몰빵하진 않는다 — 모델 추정 확률이 틀릴 가능성은 항상 있음)
HIGH_CONFIDENCE_PROBABILITY=0.85
HIGH_CONFIDENCE_SIZE_RATIO=0.75
# 스캔 시점 가격 대비 진입 직전 가격이 이만큼(%) 불리해졌으면 신호가 낡은 것으로 보고 진입 생략
STALE_SIGNAL_TOLERANCE_PCT=0.15
# 상위 시간대 추세 확인용(계산은 유지)
MTF_TIMEFRAMES=5m,15m
# [2026-08-06] 펌프감지 신호는 상위시간대 추세와 무관하게 발생할 수 있어 사실상 무력화(0.0)
MTF_MIN_AGREE_RATIO=0.5
# 1분봉 스캘핑 기준 ADX 만점 기준치 (1분봉은 ADX가 50까지 잘 안 올라가므로 낮게 잡음)
PROBABILITY_ADX_CAP=25

# 폴링 주기(초) — 과도한 매매 빈도(수수료 부담) 완화를 위해 30초로 조정
POLL_INTERVAL_SEC=30

# 1) 유동성 얇은 시간대(UTC 기준 시각, 콤마로 여러 개)에는 신규 진입을 쉼. 예: 1,2,3,4
BLOCKED_HOURS_UTC=

# 2) 펀딩비 정산 시각(UTC 00/08/16시) 전후 이 분(分) 동안은 신규 진입을 쉼
FUNDING_AVOID_MINUTES=5
# [2026-08-05] 위 시간대엔 기존 포지션도 강제 정리함(정산 급변동 리스크 회피). 단, ROE가 이
# 값(%) 이상으로 이미 크게 수익 중이면 그대로 둠
FUNDING_FORCE_CLOSE_EXEMPT_ROE=4.0
# [2026-08-06] 정산 시각 1분 전부터는 수익 여부와 무관하게(예외 없이) 강제 정리
FUNDING_UNCONDITIONAL_CLOSE_MIN=1.0
# [2026-08-06] 펌프감지 재설계 후 비활성화 — 스윙처럼 오래 태우면 안 되므로 절대 도달 불가능한
# 값(999)으로 설정해 예외 없이 SCALP_MAX_HOLD_MINUTES 타임스탑이 항상 작동하게 함
TIME_STOP_TREND_EXEMPT_MIN_RATIO=999

# 3) 비트코인이 최근 이만큼(분) 동안 이 비율(%) 이상 급락/급등했으면, 그 코인 신호와 무관하게
# 이번 주기 신규 진입을 쉼 (알트코인은 BTC 급변동에 같이 끌려가는 경향이 강함)
BTC_CHECK_SYMBOL=BTCUSDT
BTC_SUDDEN_MOVE_PCT=1.2
BTC_LOOKBACK_CANDLES=3

# 4) 한 심볼에서 연속 손실이 이 횟수 이상이면, 이 시간(분) 동안 그 심볼 신규 진입을 쉼
SYMBOL_BLACKLIST_LOSS_THRESHOLD=2
SYMBOL_BLACKLIST_COOLDOWN_MIN=60

# [2026-08-06] 같은 코인에 이 시간(분) 안에 재진입하면 비중을 직전 진입 대비 이 배수 이하로
# 축소(재진입 자체는 막지 않음)
SAME_SYMBOL_REENTRY_WINDOW_MIN=60
SAME_SYMBOL_REENTRY_RATIO_MULT=0.45

# [2026-08-06] 익절로 끝난 직후엔 이 시간(분) 동안 같은 심볼 재진입을 아예 금지(손절 후 재진입은
# 그대로 허용)
POST_WIN_REENTRY_COOLDOWN_MIN=1

# 5) 펀딩비(시장 쏠림/고래 포지셔닝 신호)가 이 절대값(%)을 넘으면 그 심볼은 거름
MAX_ABS_FUNDING_RATE_PCT=0.05
# 위 기준을 넘는 "고래성 코인"은 진입은 허용하되 이 상한을 강제 적용함 (총자산 비중/레버리지/격리마진)
WHALE_MAX_POSITION_RATIO=0.10
WHALE_MAX_LEVERAGE=3

# 테이커 매수 비율이 이 값 이상/이하로 확실히 한쪽으로 쏠려야 진입 (0.5=중립, 0.55면 매수우위 55%)
TAKER_IMBALANCE_THRESHOLD=0.58

# 최근 캔들 평균 거래대금(USDT/분)이 이 값 미만이면 후보에서 제외 (극도로 얇은 유동성 배제)
MIN_AVG_QUOTE_VOLUME_USDT=135

# [2026-08-07] 평소 유동성(평균 거래대금) 기반 비중 스케일링 — MIN_AVG_QUOTE_VOLUME_USDT
# 근처면 비중을 LIQUIDITY_SIZE_MIN_MULT까지 축소, 이 값 이상이면 축소 없음(1.0배)
LIQUIDITY_SIZE_FULL_USDT=2000
LIQUIDITY_SIZE_MIN_MULT=0.5

# 보유 포지션 재평가: 1시간봉이 새로 바뀔 때마다, 손실 중인 포지션 방향을 상위시간대
# (1시간/15분/5분)가 여전히 지지하는지 재확인한다. 손실이 이 값(ROE%) 이상이고 상위시간대
# 과반이 더 이상 지지하지 않으면, 정식 손절선까지 기다리지 않고 지금 더 작은 손실에서 정리(약손절)
SOFT_STOP_MIN_LOSS_ROE=1.5
SOFT_STOP_MTF_MIN_RATIO=0.5

# [2026-08-06] 펌프감지 신호는 일회성 이벤트라 2봉 연속 요구 시 대부분 걸러짐 — 꺼둠
REQUIRE_TWO_CANDLE_CONFIRMATION=False

# [2026-08-06] 펌프감지 트리거 — 72시간/200심볼 교차검증 기준값. 2.5%는 신호가 뜸해서
# 같은 검증에서 신호 40% 더 많았던 2.0%(여전히 흑자)로 완화
PUMP_MIN_CANDLE_CHG_PCT=0.8
PUMP_MIN_VOLUME_RATIO=2.3
