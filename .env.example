# Binance API 키 (선물 거래 권한 필요, 출금 권한은 끄는 것을 강력 권장)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# true 로 두면 Binance Futures Testnet(모의투자)로 접속합니다.
# 처음 실행하는 것이라면 반드시 true로 먼저 검증하세요.
USE_TESTNET=true

# 거래할 심볼 (쉼표로 여러 개 지정 가능, AUTO로 두면 거래 가능한 USDT 무기한 선물 코인을 자동으로 대상에 포함)
SYMBOLS=AUTO
# AUTO일 때 24시간 거래대금 상위 몇 개까지만 스캔할지 (너무 많으면 API 요청 한도 초과 위험)
# [2026-08-10 19:xx] 실측 발견: 250심볼 스캔 사이클이 평균 60~127초 걸려(설계 의도 30초의
# 2~4배) 짧게 스쳐가는 1분봉 펌프를 놓치는 원인이 됨(REST 왕복 누적). WS 레이어는 테스트넷
# 검증 결과 ~90초마다 프리징 재발생해 아직 신뢰 불가 판단 — 대신 스캔 범위 자체를 줄임.
# 오늘 실제 진입 259건 중 상위100 커버율 74.1%(상위50은 51.7%로 손실 과다) 확인 후 250->100.
# [2026-08-12 사용자요청] "거래대금 상위 50개만 상시로 스캔" — 100->50.
# [2026-08-13 사용자요청] ONEUSDT 실측 사례(01:40 -5.24%+거래량3.9배로 신호조건은 충분했으나
# 그 시점 거래대금 50위 밖이라 스캔 자체가 안 됨) — 50->70으로 확장해 사각지대 축소. 원복시 50,
# 이전 원복은 100으로.
MAX_AUTO_SYMBOLS=70

# 캔들 주기
# [2026-08-06] 펌프감지 재설계 — 72시간/200심볼 백테스트가 5분봉 기준으로 검증됐으므로 일치시킴
INTERVAL=1m

# 레버리지 (신호 강도에 따라 이 범위 안에서 자동 결정)
# [2026-08-05] 사용자 요청으로 4배 고정 (min=max=4)
LEVERAGE_MIN=4
LEVERAGE_MAX=4

# 포지션 비중 (연속 승리 시 이 범위 안에서 자동으로 커짐, 손실 나면 최소치로 복귀)
# [2026-08-10 5시간 집중투입 테스트 — logs/concentrated_test_revert_notes.txt에 원복값 기록됨]
# [2026-08-10 20:xx 사용자요청] "건당 수익이 너무 작다"(백테스트 실측 건당 0.048USDT) — 원인은
# 초기진입이 1.5%로 고정되고 물타기(최대 11.83%p 추가)에 의존해서, 물타기 없이 끝나는 거래는
# 원금 자체가 작았기 때문. 물타기 여유분을 없애고 슬롯 예산(13.33%, 3슬롯=총노출40%) 전액을
# 초기진입에 실어 건당 수익을 키운다. 백테스트: 승률 58.3%->57.4%(거의 동일), 수익률
# +6.9%->+73.8%, 건당평균이익 0.048->0.403USDT, 시간당수익 최대(+0.341USDT/h). 대신 물타기
# 완충 여유가 없어져 최대낙폭이 잔고대비 2.3%->20.8%로 커짐(사용자 인지 후 승인).
# [2026-08-11 사용자요청] "SHORT는 자동방어로 이미 비중축소 중이니 LONG쪽 슬롯당 비중을
# 일시적으로 늘려보자" — 16%->19%. SHORT도 같이 오르지만 SHORT는 방향별 성과 배율(51%
# 등)로 이미 크게 눌려있어 실효 증가폭이 작음. 임시 조정, 원복시 0.16으로.
POSITION_SIZE_MIN=0.19
POSITION_SIZE_MAX=0.19
POSITION_SIZE_STEP=0

# 잔고가 이 값(USDT) 미만이면 아래 최대 비중까지 허용 (소액일 때 최소주문금액 충족을 위해)
# [2026-08-06] 펌프감지 재설계 후 사용자 요청으로 100%→40%로 하향(POSITION_SIZE_MAX와 동일) —
# 연승 중이어도 한 거래에 잔고가 집중되지 않도록 제한
SMALL_BALANCE_THRESHOLD=500
# [2026-08-10 20:xx] 위와 동일한 이유로 POSITION_SIZE_MAX와 함께 0.1333으로 상향.
# [2026-08-11 사용자요청] POSITION_SIZE_MAX와 함께 0.19로 임시 상향. 원복시 0.16으로.
SMALL_BALANCE_MAX_RATIO=0.19

# 총자산이 이 값(USDT) 미만이면 동시 보유 포지션을 1~MAX_POSITIONS_LOW개로 제한(자금 비례),
# 이상이면 MAX_POSITIONS_HIGH개까지 허용
BALANCE_TIER_THRESHOLD=300
# [2026-08-10 17:xx 사용자요청] 거래 빈도 증가를 위해 2->3슬롯으로 확대. 슬롯당 마진상한은
# AVERAGE_DOWN_MAX_TOTAL_MARGIN_RATIO=0.10 그대로 유지(총 노출 최대 30%로 제한).
# 사용자가 마진노출 60%(슬롯당20%)를 요청했으나 백테스트 결과 거래빈도는 30%안과 동일(6.8건/h)하고
# 최대낙폭만 15%->32.6%, 최악손실 -0.58->-1.53으로 커져서 30%(슬롯당10%) 유지로 합의됨.
# 정식엔진(offline_backtest.py) 백테스트: 3슬롯/노출30% 시 시간당거래 4.9->6.8건, 승률54.7%->55.8%,
# 수익률+35%->+59.9%, 최대DD 잔고대비15.0%.
MAX_POSITIONS_LOW=5
MAX_POSITIONS_HIGH=5

# 총자산이 이 값(USDT) 미만이면 초기 자금 불리기 단계로 보고 조금 더 공격적으로 거래함
# (동시 포지션 개수 확대 + 진입 신호 기준 완화)
AGGRESSIVE_BALANCE_THRESHOLD=100
AGGRESSIVE_MAX_POSITIONS=5
AGGRESSIVE_MIN_SIGNAL_CONFIRMATIONS=2

# [2026-08-12 사용자요청] 코덱스가 만든 저잔고 보호모드(총자산이 이 값 미만이면 고확률
# 후보만 진입) 완화 — 오늘 SHORT TP/SL, 휩쏘필터, 유예기간 등 여러 개선이 이미 적용돼
# 있어서 예전만큼 보수적으로 안 가도 괜찮다는 판단. 임계값 25->17, 확률기준 0.80->0.65.
